POSTGRES_DB=sltours
POSTGRES_USER=sltours
POSTGRES_PASSWORD=sltours

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/sltours
SPRING_DATASOURCE_USERNAME=sltours
SPRING_DATASOURCE_PASSWORD=sltours
SLTOURS_ADMIN_USERNAME=admin@sltours.local
SLTOURS_ADMIN_PASSWORD=change-me-in-env
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

VITE_API_BASE_URL=
# Local HTTP Docker defaults; use production and true behind HTTPS when deployed.
SPRING_PROFILES_ACTIVE=dev
SESSION_COOKIE_SECURE=false

# Operations features (see docs/operations/MEDIA_STORAGE.md and docs/product/SL_TOURS_OPERATIONS_REQUIREMENTS.md)
# Signed-in users are signed out after this much inactivity.
SLTOURS_IDLE_TIMEOUT=30m
# true: a collection without safety defects waits for admin approval before the vehicle is released.
SLTOURS_COLLECTION_APPROVAL_REQUIRED=true
SLTOURS_INSPECTION_MIN_PHOTOS=4
SLTOURS_COLLECTION_OPENS_BEFORE=12h
# Invoices and quotations: base URL in customer document links, and how long links last (days, max 90).
SLTOURS_DOCUMENT_LINK_BASE_URL=https://sl-tours.com
SLTOURS_DOCUMENT_LINK_DAYS=14
# Inside the API container; mounted from the media-data volume by docker-compose.yml.
SLTOURS_MEDIA_ROOT=/var/lib/sltours/media
# dev profile only: password for the seeded demo driver sign-ins.
SLTOURS_DEV_DRIVER_PASSWORD=driver-demo-pass

# Customer account emails: verification and password reset (see docs/operations/CUSTOMER_ACCOUNTS.md).
# Local Docker sends them to Mailpit (inbox at http://localhost:8025); nothing leaves this machine.
# A deployment must use a real SMTP provider; the production profile refuses mailpit/localhost.
SLTOURS_MAIL_PROVIDER=smtp
SLTOURS_MAIL_FROM=SL Tours <no-reply@sltours.local>
SLTOURS_SMTP_HOST=mailpit
SLTOURS_SMTP_PORT=1025
SLTOURS_SMTP_USERNAME=
SLTOURS_SMTP_PASSWORD=
SLTOURS_SMTP_STARTTLS=false
# Base of the links in those emails (no trailing slash).
SLTOURS_ACCOUNT_LINK_BASE_URL=http://localhost:8080

# Shared and production environments: run Flyway as the schema owner and the API as the restricted role
# (tools/db/roles.sql; docs/operations/BACKUP_AND_RECOVERY.md). Leave unset locally.
# SPRING_FLYWAY_USER=sltours_owner
# SPRING_FLYWAY_PASSWORD=

# Search indexing. Leave blank or false for local, preview and staging copies (every page is noindex and the sitemap is
# hidden). Set true only on the public production site. The production profile requires an explicit true or false.
SLTOURS_SEO_INDEXING=
SLTOURS_PUBLIC_BASE_URL=https://sl-tours.com
